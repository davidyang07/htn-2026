# AgentShield — example environment file.
#
# Copy to `.env` and fill in locally. `.env` is gitignored; this file is
# committed and MUST contain empty placeholders only. Never commit a real
# value here.
#
# WorkSwarm / openJiuwen sponsor-model credentials are configured manually
# OUTSIDE this repository (see docs/WORKSWARM.md) and deliberately have no
# placeholder here.

# --- Postgres (existing simulator persistence; defaults in app/config.py) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Existing self-hosted / OpenAI-compatible model endpoint (app/config.py) ---
VLLM_BASE_URL=
VLLM_API_KEY=

# --- Sentry (observability; optional — absent DSN disables Sentry entirely) ---
SENTRY_DSN=

# --- OpenAI (optional reviewer / incident explanation; never a security decision) ---
OPENAI_API_KEY=

# --- RunPod self-hosted replacement-worker model (P1, optional) ---
RUNPOD_MODEL_BASE_URL=
RUNPOD_MODEL_API_KEY=
RUNPOD_MODEL_NAME=

# --- Live Swarm Demo (docs/DEMO.md) ---------------------------------------
# AgentShield's own port. WorkSwarm also defaults to 8000, so the documented
# local setup puts AgentShield on 8100 and leaves 8000 free for WorkSwarm.
AGENTSHIELD_BASE_URL=http://localhost:8100

# The model the WorkSwarm workers run on. Any OpenAI-compatible endpoint:
# OpenAI, a RunPod vLLM pod, Ollama (http://localhost:11434/v1), LM Studio,
# or a sponsor gateway. Leave unset to run the workers as deterministic
# stand-ins -- the demo still works end to end and says which mode it was in.
AGENTSHIELD_MODEL_BASE_URL=
AGENTSHIELD_MODEL_API_KEY=
AGENTSHIELD_MODEL_NAME=
AGENTSHIELD_MODEL_PROVIDER=

# Optional: overrides for the post-hoc incident explanation, which uses
# OPENAI_API_KEY above when it is set. Never an input to a policy decision.
OPENAI_BASE_URL=
OPENAI_MODEL=
